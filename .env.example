# .env.example — copy this to .env and fill in your values
# NEVER commit .env to git

# watsonx Orchestrate credentials
# Get WXO_API_KEY from: Orchestrate UI -> Settings -> API access
# Get WXO_URL from:     Orchestrate UI -> Settings -> API access (the instance URL)
WXO_API_KEY=your_api_key_here
WXO_URL=https://api.us-east-1.watson-orchestrate.ibm.com/instances/your-instance-id
