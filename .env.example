# .env.example — copy this to .env and fill in your values
# NEVER commit .env to git

# watsonx Orchestrate (AWS-hosted trial)
# Get these from: Orchestrate UI -> Settings -> API access
WATSONX_ORCHESTRATE_API_KEY=your_api_key_here
WATSONX_ORCHESTRATE_URL=https://api.us-east-1.watson-orchestrate.ibm.com/instances/your-instance-id
